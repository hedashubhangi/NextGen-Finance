{
  "name": "nextgen-finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "nodemon backend/index.js",
    "server": "node backend/index.js",
    "build": "tsc -b && vite build frontend --config frontend/vite.config.ts",
    "lint": "oxlint",
    "preview": "vite preview frontend --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.4",
    "@netlify/functions": "^6.0.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "nodemon": "^3.1.14",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
